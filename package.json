{
  "name": "bandagejs",
  "private": true,
  "description": "Bandage-style pangenome graph viewer in the browser, built on @jbrowse/bandage-core",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "pnpm build && ./scripts/deploy.sh",
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e"
  },
  "devDependencies": {
    "@gmod/tabix": "^3.8.3",
    "@jbrowse/bandage-core": "^4.4.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "generic-filehandle2": "^2.4.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  }
}
